# Trainual API token, used by `npm run build` to read page content.
# Trainual -> Settings -> API. Content read scope is sufficient.
TRAINUAL_API_TOKEN=


# GitHub Pages target for `npm run deploy:gh` (must be a PUBLIC repo on the free plan).
#   https://github.com/<user-or-org>/<repo>.git
GH_PAGES_REPO=

# Only if the Pages site uses a custom domain. github.io then redirects to it without
# a CORS header, which breaks the widget, so serve it from the canonical origin.
#   GH_PAGES_URL=https://www.example.com/<repo>
GH_PAGES_URL=
